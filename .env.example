# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Stripe webhooks, usage metering and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional model overrides (defaults shown). Pro users get the stronger model.
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4o

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# Public URL of the app, used for Stripe and auth redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
